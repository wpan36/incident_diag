# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# The Makefile loads this file and exports it to every recipe, and passes it on
# to docker compose, so `make up`, `make migrate-up` and `make test-integration`
# need nothing exported by hand. Running a binary directly outside make does:
# `env $(grep -v "^#" .env | xargs -d "\n") go run ./cmd/api`, or export the
# variables yourself.
#
# Do not `source .env`. The DSN below contains `(`, `)` and `&`, which bash
# parses rather than takes literally, and sourcing sets shell variables that a
# child process does not inherit anyway. For the same reason the values here
# stay unquoted: make and compose both parse this file directly, and quotes
# would become part of the value.

# ---- Chat LLM (any OpenAI-compatible endpoint) -----------------------------
# Default is DeepSeek. Pointing these at any other OpenAI-compatible provider
# is all it takes to switch backends — the agent runtime knows nothing about
# the provider, and a smoke test proves it.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- Embeddings (separate endpoint, separate key) --------------------------
# DeepSeek has no embeddings endpoint, so this is a different provider.
# SiliconFlow hosts the same BAAI/bge-m3 the Elasticsearch mapping is built
# for, at 1024 dimensions. Changing the model here means reindexing everything.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---- MySQL ----------------------------------------------------------------
# The first five are read by docker compose when it starts the server; the DSN
# is read by the Go binaries. They have to agree — in particular MYSQL_PORT and
# the port inside MYSQL_DSN, which is what a second MySQL already listening on
# 3306 will otherwise quietly break.
#
# parseTime=true&loc=UTC are not optional. Without parseTime the driver returns
# DATETIME(6) as bytes and every scan into a time.Time fails; without loc=UTC it
# interprets stored timestamps in the local zone. The store refuses to start if
# either is missing.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=incident_diag
MYSQL_USER=incident
MYSQL_PASSWORD=incident
MYSQL_PORT=3307
MYSQL_DSN=incident:incident@tcp(127.0.0.1:3307)/incident_diag?parseTime=true&loc=UTC

# Connection pool. Defaults shown.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Integration tests run only when this is set, so `go test ./...` stays green
# on a machine with no infrastructure. They create and drop schema, so this
# must not point at a database holding anything you want to keep.
TEST_MYSQL_DSN=incident:incident@tcp(127.0.0.1:3307)/incident_diag?parseTime=true&loc=UTC

# ---- HTTP server ----------------------------------------------------------
# Defaults shown. The SSE endpoint in M26 will need its own handling rather
# than a write timeout raised until it stops mattering.
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s

# ---- Uploaded documents ---------------------------------------------------
# The API writes these files and the ingestion worker reads them, so both must
# point at the same volume. The default root is a container path; running the
# binaries directly wants something writable, such as ./data/documents.
DOCUMENT_STORAGE_ROOT=/var/lib/incident_diag/documents
DOCUMENT_MAX_UPLOAD_BYTES=10485760
