# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---- Chat LLM (any OpenAI-compatible endpoint) -----------------------------
# Default is DeepSeek. Pointing these at a local vLLM server is all it takes to
# switch backends — the agent runtime knows nothing about the provider.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- Embeddings (separate endpoint) ---------------------------------------
# Served locally by vLLM (BAAI/bge-m3), also OpenAI-compatible.
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_API_KEY=not-needed-for-local
EMBEDDING_MODEL=BAAI/bge-m3
